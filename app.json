{
  "expo": {
    "name": "Loro",
    "slug": "spanish-cards",
    "owner": "izbrodin90",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "spanishcards",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15253C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spanishcards.app",
      "icon": "./assets/icon.png",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spanishcards.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15253C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "274440f6-12c8-4b4b-bab2-43b56f8fb952"
      }
    }
  }
}
